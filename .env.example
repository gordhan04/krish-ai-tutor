# Application Configuration
APP_NAME="KRISH AI TUTOR"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use local SQLite for instant zero-dependency execution:
DATABASE_URL="sqlite+aiosqlite:///./krish_tutor.db"
# Or PostgreSQL + pgvector for production:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/krish_tutor"

# AI Provider: "mock" (default, zero-cost tests), "gemini", or "openai"
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_FAST="gemini-2.5-flash"
AI_MODEL_ADVANCED="gemini-2.5-pro"

# Vector Search
EMBEDDING_MODEL="text-embedding-004"
VECTOR_SEARCH_TOP_K=4
VECTOR_SIMILARITY_THRESHOLD=0.60
