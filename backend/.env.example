# Application Configuration
APP_NAME="KRISH AI TUTOR"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# In Production/Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/krish_ai_tutor
# For local instant dev: sqlite+aiosqlite:///./krish_tutor.db
DATABASE_URL="sqlite+aiosqlite:///./krish_tutor.db"

# AI Provider Configuration: 'gemini', 'openai', or 'mock'
AI_PROVIDER="mock"

# Provider Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# AI Models
AI_MODEL_FAST="gemini-2.5-flash"
AI_MODEL_ADVANCED="gemini-2.5-pro"
EMBEDDING_MODEL="text-embedding-004"

# Vector Search Configuration
VECTOR_SEARCH_TOP_K=4
VECTOR_SIMILARITY_THRESHOLD=0.65

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
